{
  "name": "aaruthrun-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static engineering portfolio with a folder-driven project gallery map.",
  "scripts": {
    "brand": "node tools/make-brand-images.js",
    "cards": "node tools/make-share-cards.js",
    "gallery": "node tools/build-gallery.mjs",
    "responsive": "node tools/build-responsive.mjs",
    "responsive:check": "node tools/build-responsive.mjs --check",
    "cv": "node tools/build-cv.mjs",
    "gallery:watch": "node tools/build-gallery.mjs --watch",
    "pages": "node tools/build-pages.mjs",
    "pages:check": "node tools/build-pages.mjs --check",
    "serve": "npx -y http-server -p 8080 -c-1 --cors .",
    "check": "node tools/check-site.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
